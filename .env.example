# ── AI (둘 중 하나만 있으면 돼요) ─────────────────────
# OpenAI API 키 (https://platform.openai.com/api-keys) — sk- 로 시작
OPENAI_API_KEY=
# 또는 Google Gemini API 키 (Google AI Studio 또는 Vertex AI express)
# OPENAI_API_KEY 자리에 Gemini 키를 넣어도 자동으로 인식해요.
GEMINI_API_KEY=
# 선택: 사용할 모델 (기본값 OpenAI는 gpt-4o-mini, Gemini는 gemini-3.8-flash)
AI_MODEL=
# 피드백 속도용 (채팅과 별도, 기본 gemini-2.5-flash → flash-lite → 3.6-flash)
# GEMINI_FEEDBACK_MODELS=

# ── 대화 기록 / 보관함 동기화 저장소 ───────────────────
# 비워두면 로컬 개발 시 .data/store.json 파일에 저장합니다.
# Vercel 등 서버리스 배포 시에는 Upstash Redis(또는 Vercel KV) 값을 반드시 넣어주세요.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV 연동 시 자동으로 들어오는 KV_REST_API_URL / KV_REST_API_TOKEN 도 인식합니다)

# ── 가사 제공 API ──────────────────────────────────
# 기본값은 LRCLIB 공개 API입니다. 상용 서비스로 운영할 때는 라이선스가 있는 가사 제공처를 사용하세요.
LYRICS_API_BASE=https://lrclib.net/api

# ── 보호 장치 ──────────────────────────────────────
# IP당 1분에 허용할 AI 요청 수
AI_RATE_LIMIT_PER_MIN=20
